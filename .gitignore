# ─────────────────────────────
# Dependencies
# ─────────────────────────────
node_modules/

# ─────────────────────────────
# Expo
# ─────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ─────────────────────────────
# Native / Mobile
# ─────────────────────────────
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ─────────────────────────────
# Metro bundler
# ─────────────────────────────
.metro-health-check*

# ─────────────────────────────
# Debug logs
# ─────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*

# ─────────────────────────────
# macOS system files
# ─────────────────────────────
.DS_Store
*.pem

# ─────────────────────────────
# Environment files
# (tracks .env.production, .env.staging, etc. but not the root .env)
# ─────────────────────────────
.env
.env*.local

# ─────────────────────────────
# TypeScript
# ─────────────────────────────
*.tsbuildinfo

# ─────────────────────────────
# Project-specific examples
# ─────────────────────────────
app-example

# ─────────────────────────────
# Generated native folders (for React Native / Expo prebuild)
# ─────────────────────────────
/ios
/android

